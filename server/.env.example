# Servidor
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Base de datos (MongoDB en Railway)
MONGODB_URI=

# Autenticacion
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (imagenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (pagos)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# El Tiempo (OpenWeather - el backend hace de proxy, la key nunca viaja al cliente)
OPENWEATHER_API_KEY=
