# Servidor
PORT=5000
NODE_ENV=development
# Origenes que pueden llamar a la API desde un navegador, separados por
# comas. Un dominio propio son al menos dos (con y sin www). En produccion
# es OBLIGATORIA: sin ella la API queda abierta a cualquier web.
#   produccion: CLIENT_URL=https://milepe.com,https://www.milepe.com
CLIENT_URL=http://localhost:5173

# Base de datos (MongoDB en Railway). Pega aqui la variable que Railway te
# de, sea cual sea su nombre (MONGO_URL, MONGODB_URL...): conectarDB() acepta
# MONGODB_URI, MONGODB_URL o MONGO_URL indistintamente.
MONGODB_URI=

# Autenticacion
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (imagenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (pagos). Sin STRIPE_SECRET_KEY no se ofrece pagar. sk_test_... = modo
# de prueba (tarjetas ficticias). STRIPE_WEBHOOK_SECRET es el "Signing secret"
# del endpoint https://api.milepe.com/api/pagos/webhook en el panel de Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcionales: precios en centimos (IVA incluido) y web a la que vuelve Stripe.
# PRECIO_NEGOCIO_DESTACADO_CENT=990
# PRECIO_EVENTO_PATROCINADO_CENT=490
# PRECIO_VERIFICACION_CENT=150
# SITIO_URL=https://milepe.com

# Entrar con Google. El mismo ID de cliente va aqui y en el cliente
# (VITE_GOOGLE_CLIENT_ID): aqui para comprobar que el token recibido se
# emitio para NUESTRA aplicacion, alli para pintar el boton. No es un
# secreto -viaja al navegador-, pero sin el no funciona el acceso.
# Se saca de Google Cloud Console > Credenciales > ID de cliente de OAuth.
GOOGLE_CLIENT_ID=

# Correo saliente (recuperacion de contraseña). Por SMTP a proposito, que
# lo hablan todos los proveedores: cambiar de Brevo a Resend o a quien sea
# es cambiar estas variables, no el codigo.
# Sin configurar, en desarrollo el correo se escribe por consola (util para
# probar el circuito entero sin dar de alta nada); en produccion se registra
# un error, porque ahi significa que nadie recibe su enlace.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=MiLepe <no-responder@milepe.com>

# El Tiempo (OpenWeather - el backend hace de proxy, la key nunca viaja al cliente)
OPENWEATHER_API_KEY=
# Opcional: milisegundos que se cachea la respuesta del tiempo en memoria.
# Por defecto 600000 (10 min). Todo el pueblo consulta el mismo municipio,
# asi que una llamada sirve para todos; bajarlo solo gasta cuota.
TIEMPO_CACHE_MS=

# Avisos push del navegador (Web Push).
#
# Son un par de claves VAPID, no una credencial de ningun servicio: se
# generan con `npx web-push generate-vapid-keys` y no hay que registrarse
# en ningun sitio. La publica viaja al navegador (la sirve la propia API
# en GET /api/notificaciones/push/clave, para que cliente y servidor no
# puedan desincronizarse); la privada se queda aqui y es lo que demuestra
# que el aviso lo manda este servidor.
#
# Sin ellas la aplicacion funciona igual: simplemente no se envian avisos
# y los vecinos los ven al abrir MiLepe.
#
# VAPID_SUBJECT tiene que ser un mailto: o una URL. Es a quien avisa el
# servicio de push (Google, Mozilla, Apple) si algo va mal con los envios.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Sentry (monitorizacion de errores del servidor). DSN del proyecto Node.js/Express
# en sentry.io > Settings > Client Keys. Vacio = no se envia nada.
SENTRY_DSN=
