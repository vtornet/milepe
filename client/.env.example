# Base de la API, con /api incluido. Si no se define, services/api.js cae
# a http://localhost:5000/api, que es lo que hace que el desarrollo
# funcione sin crear este archivo.
#
# En produccion se define en el panel del hosting del cliente (no en un
# archivo), porque Vite la incrusta en el build: cada despliegue se compila
# con el valor que tenga en ese momento.
#   produccion: VITE_API_URL=https://api.milepe.com/api
VITE_API_URL=http://localhost:5000/api

# ID de cliente de OAuth de Google, el mismo que GOOGLE_CLIENT_ID en el
# servidor. No es un secreto (viaja al navegador por definicion), pero sin
# el no se pinta el boton de "Continuar con Google": el componente
# simplemente no se muestra, en vez de enseñar un boton que no hace nada.
# Se saca de Google Cloud Console > Credenciales > ID de cliente de OAuth.
VITE_GOOGLE_CLIENT_ID=
